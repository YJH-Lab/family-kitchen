page {
  background-color: #f6f7f4;
  color: #151515;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', miui, 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
}

button {
  background: initial;
  padding: 0;
  margin: 0;
  border-radius: 0;
  line-height: normal;
  box-sizing: border-box;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}
