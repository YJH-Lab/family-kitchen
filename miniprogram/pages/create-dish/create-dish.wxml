<!--pages/create-dish/create-dish.wxml-->
<view class="container">
  <view class="cover-uploader" bindtap="chooseImage">
    <image class="cover-img" src="{{imagePath}}" mode="aspectFill" wx:if="{{imagePath}}"></image>
    <view class="upload-placeholder" wx:else>
      <text class="plus-icon">+</text>
      <text>点击上传封面大图</text>
    </view>
  </view>

  <view class="form-group">
    <view class="form-item">
      <text class="label">菜品名称</text>
      <input class="input" placeholder="请输入菜品名称" model:value="{{name}}" />
    </view>
    <view class="form-item">
      <text class="label">分类</text>
      <picker bindchange="onCategoryChange" value="{{categoryIndex}}" range="{{categories}}">
        <view class="picker-text">{{categories[categoryIndex] || '请选择分类'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">价格</text>
      <input class="input" type="digit" placeholder="¥ 0.00" model:value="{{price}}" />
    </view>
    <view class="form-item align-top">
      <text class="label">简介</text>
      <textarea class="textarea" placeholder="描述一下这道菜..." model:value="{{desc}}" auto-height></textarea>
    </view>
  </view>

  <view class="list-section">
    <view class="section-header">
      <text class="section-title">用料</text>
      <view class="add-btn" bindtap="addIngredient">+ 添加用料</view>
    </view>
    <block wx:for="{{ingredients}}" wx:key="index">
      <view class="list-row">
        <input class="input half-input" placeholder="如: 鸡蛋" value="{{item.name}}" bindinput="onIngNameInput" data-index="{{index}}" />
        <input class="input half-input" placeholder="如: 2个" value="{{item.weight}}" bindinput="onIngWeightInput" data-index="{{index}}" />
        <view class="remove-btn" bindtap="removeIngredient" data-index="{{index}}">×</view>
      </view>
    </block>
  </view>

  <view class="list-section">
    <view class="section-header">
      <text class="section-title">步骤</text>
      <view class="add-btn" bindtap="addStep">+ 添加步骤</view>
    </view>
    <block wx:for="{{steps}}" wx:key="index">
      <view class="list-row step-row">
        <text class="step-num">{{index + 1}}.</text>
        <textarea class="textarea flex-textarea" placeholder="描述步骤" value="{{item.text}}" bindinput="onStepInput" data-index="{{index}}" auto-height></textarea>
        <view class="remove-btn" bindtap="removeStep" data-index="{{index}}">×</view>
      </view>
    </block>
  </view>

  <view class="footer-area">
    <button class="submit-btn" bindtap="submitDish">发布菜谱</button>
  </view>
</view>
