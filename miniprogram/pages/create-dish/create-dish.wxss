/* pages/create-dish/create-dish.wxss */
.container {
  padding: 24rpx;
  background-color: #f6f7f4;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

.cover-uploader {
  width: 100%;
  height: 400rpx;
  background-color: #e6e8e3;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8c8c8c;
  font-size: 28rpx;
}

.plus-icon {
  font-size: 80rpx;
  font-weight: 300;
  margin-bottom: 10rpx;
  color: #b0b3ab;
}

.form-group, .list-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 10rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item.align-top {
  align-items: flex-start;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 140rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.picker-text {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.textarea {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  min-height: 80rpx;
  line-height: 1.5;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #111;
}

.add-btn {
  color: #75b884;
  font-size: 28rpx;
  font-weight: 600;
}

.list-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #f0f0f0;
}

.list-row:last-child {
  border-bottom: none;
}

.half-input {
  flex: 1;
  background-color: #f8f8f8;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.remove-btn {
  width: 48rpx;
  height: 48rpx;
  background-color: #ffeaea;
  color: #ff5252;
  border-radius: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  line-height: 44rpx;
  margin-left: 8rpx;
}

.step-row {
  align-items: flex-start;
}

.step-num {
  font-size: 30rpx;
  font-weight: bold;
  color: #75b884;
  margin-right: 16rpx;
  margin-top: 16rpx;
  width: 40rpx;
}

.flex-textarea {
  background-color: #f8f8f8;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.footer-area {
  margin-top: 40rpx;
  padding: 0 24rpx;
}

.submit-btn {
  background-color: #75b884;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  height: 88rpx;
  line-height: 88rpx;
  width: 100% !important;
}
