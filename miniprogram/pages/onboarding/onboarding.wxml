<!--pages/onboarding/onboarding.wxml-->
<view class="container">
  <image class="bg-image" src="/images/bg-onboarding.png" mode="aspectFill"></image>
  <view class="bg-overlay"></view>

  <view class="content">
    <view class="top-bar">
      <image class="home-icon" src="/images/ui-family.png" mode="aspectFit"></image>
      <text class="top-title">家庭点餐</text>
      <view class="capsule-placeholder"></view>
    </view>

    <view class="center-brand">
      <image class="brand-logo" src="/images/ui-badge.png" mode="aspectFit"></image>
      <text class="brand-title">家庭点餐</text>
      <text class="brand-subtitle">记录每一顿家的味道</text>
    </view>

    <view class="actions">
      <view class="action-card create-card" bindtap="createFamily">
        <view class="emoji-left">🥬🥕</view>
        <view class="card-text">
          <text class="action-title">创建我的家庭厨房</text>
          <text class="action-desc">我是大厨，创建菜单并邀请家人</text>
        </view>
        <view class="emoji-right">🧑‍🍳</view>
      </view>
      
      <view class="action-card join-card" bindtap="showJoinModal">
        <view class="emoji-left" style="font-size:64rpx">👋</view>
        <view class="card-text" style="margin-left: 20rpx;">
          <text class="action-title join-title">加入现有家庭</text>
          <text class="action-desc join-desc">输入家人分享的加入码</text>
        </view>
        <text class="arrow-icon">›</text>
      </view>
    </view>
  </view>
</view>
