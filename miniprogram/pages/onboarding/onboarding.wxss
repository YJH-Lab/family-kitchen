/* pages/onboarding/onboarding.wxss */
.container {
  height: 100vh;
  width: 100vw;
  position: relative;
  overflow: hidden;
  background-color: #f1faee; /* 浅柔的嫩绿色底色 */
}

/* 顶部全屏图 */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 60%; /* 只占上半部分 */
  z-index: 1;
}

/* 遮罩渐变：上方透明，下方渐变至底色 */
.bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(241, 250, 238, 0) 0%, rgba(241, 250, 238, 0.7) 40%, rgba(241, 250, 238, 1) 60%);
  z-index: 2;
}

.content {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0 40rpx;
}

/* 顶部占位 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 100rpx;
  margin-bottom: 40rpx;
}

.home-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.6;
}

.top-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f3b2b;
}

.capsule-placeholder {
  width: 48rpx;
}

/* 中心品牌区 */
.center-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 10rpx;
  margin-bottom: 60rpx;
}

.brand-logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 20rpx;
  mix-blend-mode: multiply; /* 融入白底 */
}

.brand-title {
  font-size: 80rpx;
  font-weight: 900;
  color: #1f3b2b;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.subtitle-wrapper {
  position: relative;
  display: inline-block;
}

.brand-subtitle {
  font-size: 38rpx;
  color: #3b5c46;
  font-weight: 500;
  position: relative;
  z-index: 2;
}

/* 黄色手绘下划线模拟 */

.subtitle-underline {
  position: absolute;
  bottom: 2rpx;
  left: -10rpx;
  right: -10rpx;
  height: 12rpx;
  background-color: #ffca3a;
  opacity: 0.5;
  border-radius: 10rpx;
  transform: rotate(-1.5deg);
  z-index: 1;
}

/* 卡片操作区 */
.actions {
  width: 100%;
  margin-top: auto;
  margin-bottom: 60rpx;
}

.action-card {
  position: relative; /* 为悬浮图提供定位点 */
  display: flex;
  align-items: center;
  border-radius: 36rpx;
  padding: 70rpx 40rpx 70rpx 240rpx; /* 上下各加 10rpx (约 5px) 的高度 */
  margin-bottom: 50rpx;
  box-shadow: 0 16rpx 40rpx rgba(117, 184, 132, 0.2);
}

.create-card {
  background: radial-gradient(circle at 5% 50%, #ffffff 0%, #ffffff 15%, #97cc93 45%, #75b884 100%);
  overflow: hidden; /* 防止水印溢出 */
}

.join-card {
  background-color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(240, 220, 160, 0.3); /* 淡淡的黄色投影 */
  overflow: visible; /* 允许便利贴溢出 */
}

/* 绝对定位的破框插画 */
.card-float-img {
  position: absolute;
  mix-blend-mode: multiply; /* 消除生成图的白底 */
  z-index: 10;
}

.float-salad {
  width: 260rpx;
  height: 260rpx;
  left: -30rpx;
  top: 50%;
  transform: translateY(-50%);
}

.float-sticky {
  width: 220rpx;
  height: 220rpx;
  left: 0;
  top: 0;
}

.sticky-container {
  position: absolute;
  left: -20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 220rpx;
  height: 220rpx;
  z-index: 10;
}

.sticky-text {
  position: absolute;
  top: 50rpx;
  left: 30rpx;
  display: flex;
  flex-direction: column;
  transform: rotate(-3deg);
  z-index: 11;
}

.sticky-label {
  font-size: 26rpx;
  color: #8c8c8c;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.sticky-code {
  font-size: 42rpx;
  color: #75b884;
  font-weight: 900;
  letter-spacing: 2rpx;
}

/* 右侧水印 */
.card-watermark {
  position: absolute;
  right: -30rpx;
  top: -40rpx;
  font-size: 260rpx;
  opacity: 0.08;
  color: #fff;
  z-index: 0;
  pointer-events: none;
}

/* 卡片文字 */
.card-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  position: relative;
  z-index: 5;
}

.action-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.action-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  white-space: nowrap;
}

.join-title {
  color: #333333;
  text-shadow: none;
}

.join-desc {
  color: #8c8c8c;
}

/* 圆形箭头 */
.arrow-circle {
  position: relative;
  z-index: 5;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.arrow-circle text {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}

.green-arrow {
  background-color: #ffffff;
  color: #75b884;
}

.light-green-arrow {
  background-color: #eaf4ed;
  color: #5ba46a;
}

/* 底部保障条 */
.footer {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
  opacity: 0.8;
}

.footer-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #55705d;
}

.footer-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.footer-divider {
  margin: 0 24rpx;
  color: #cce0d1;
  font-size: 24rpx;
}
