/* pages/onboarding/onboarding.wxss */
.container {
  height: 100vh;
  width: 100vw;
  position: relative;
  overflow: hidden;
  background-color: #f6f7f4;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.6) 40%, rgba(255,255,255,0.95) 80%, rgba(255,255,255,1) 100%);
  z-index: 2;
}

.content {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0 40rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 100rpx;
  margin-bottom: 80rpx;
}

.home-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.6;
}

.top-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.capsule-placeholder {
  width: 48rpx; /* Placeholder for alignment */
}

.center-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
  margin-bottom: 80rpx;
}

.brand-logo {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background-color: transparent;
  box-shadow: 0 10rpx 40rpx rgba(36, 107, 72, 0.1);
}

.brand-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #1f3b2b;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.brand-subtitle {
  font-size: 32rpx;
  color: #555;
  font-weight: 300;
}

.actions {
  width: 100%;
  margin-top: auto;
  margin-bottom: 120rpx;
}

.action-card {
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.08);
}

.create-card {
  background: linear-gradient(135deg, #7fc08e 0%, #5ba46a 100%);
}

.join-card {
  background-color: #ffffff;
}

.emoji-left {
  font-size: 56rpx;
  margin-right: 20rpx;
  line-height: 1;
}

.emoji-right {
  font-size: 80rpx;
  margin-left: auto;
  background: #ffffff;
  border-radius: 50%;
  padding: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.arrow-icon {
  font-size: 60rpx;
  color: #b7b7b7;
  margin-left: auto;
  font-weight: 300;
}

.card-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.action-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.action-desc {
  font-size: 26rpx;
  color: #eef2ec;
}

.join-title {
  color: #111;
}

.join-desc {
  color: #8c8c8c;
}
