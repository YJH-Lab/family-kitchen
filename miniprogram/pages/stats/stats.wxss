/* pages/stats/stats.wxss */
.container {
  min-height: 100vh;
  background-color: #f6f7f4;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.summary-card {
  background-color: #ffffff;
  border-radius: 18rpx;
  padding: 30rpx;
  box-shadow: 0 5rpx 18rpx rgba(0, 0, 0, 0.04);
}

.summary-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.summary-label {
  font-size: 30rpx;
  color: #8c8c8c;
}

.summary-amount {
  margin-top: 12rpx;
  color: #d97845;
  font-size: 62rpx;
  line-height: 1;
  font-weight: 800;
}

.currency {
  font-size: 34rpx;
  margin-right: 4rpx;
}

.summary-icon {
  width: 86rpx;
  height: 86rpx;
}

.mode-tabs {
  display: flex;
  margin-top: 32rpx;
  padding: 6rpx;
  background-color: #f0f1ee;
  border-radius: 36rpx;
}

.mode-item {
  flex: 1;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  color: #777777;
  font-size: 29rpx;
  font-weight: 600;
}

.mode-item.active {
  background-color: #75b884;
  color: #ffffff;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 18rpx;
}

.metric-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 5rpx 18rpx rgba(0, 0, 0, 0.04);
}

.metric-value {
  display: block;
  color: #111111;
  font-size: 40rpx;
  font-weight: 800;
}

.metric-label {
  display: block;
  margin-top: 8rpx;
  color: #8c8c8c;
  font-size: 26rpx;
}

.section-card {
  margin-top: 18rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  box-shadow: 0 5rpx 18rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  margin-bottom: 22rpx;
  color: #111111;
  font-size: 34rpx;
  font-weight: 800;
}

.trend-item {
  display: grid;
  grid-template-columns: 88rpx 1fr 112rpx;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.trend-item:last-child {
  margin-bottom: 0;
}

.trend-label {
  color: #111111;
  font-size: 28rpx;
  font-weight: 600;
}

.trend-track {
  height: 18rpx;
  background-color: #eef2ec;
  border-radius: 12rpx;
  overflow: hidden;
}

.trend-bar {
  height: 100%;
  min-width: 8rpx;
  background-color: #75b884;
  border-radius: 12rpx;
}

.trend-amount {
  color: #d97845;
  font-size: 28rpx;
  font-weight: 700;
  text-align: right;
}

.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ececec;
}

.order-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.order-main {
  flex: 1;
  min-width: 0;
}

.order-date {
  display: block;
  color: #111111;
  font-size: 30rpx;
  font-weight: 700;
}

.order-desc {
  display: block;
  margin-top: 8rpx;
  max-width: 440rpx;
  color: #8c8c8c;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-amount {
  color: #d97845;
  font-size: 32rpx;
  font-weight: 800;
}

.order-actions {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.delete-btn {
  margin-top: 10rpx;
  width: 92rpx !important;
  height: 46rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background-color: #f6f0ec;
  color: #c66c3d;
  font-size: 24rpx;
  line-height: normal;
}

.empty-state {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 190rpx;
  height: 190rpx;
}

.empty-title {
  margin-top: 24rpx;
  color: #111111;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 12rpx;
  color: #8c8c8c;
  font-size: 26rpx;
}

.top-dish-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ececec;
}

.top-dish-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.rank-medal {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: #eef2ec;
  color: #777777;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.rank-medal.rank-1 {
  background-color: #ffd700;
  color: #fff;
}

.rank-medal.rank-2 {
  background-color: #c0c0c0;
  color: #fff;
}

.rank-medal.rank-3 {
  background-color: #cd7f32;
  color: #fff;
}

.top-dish-name {
  flex: 1;
  color: #111111;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.top-dish-count {
  color: #8c8c8c;
  font-size: 26rpx;
}
