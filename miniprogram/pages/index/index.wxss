/* pages/index/index.wxss */

/* ========== 页面容器 ========== */
.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F5F5F3;
}

/* ========== 自定义导航栏 ========== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #FFFFFF;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 18rpx;
}

.greeting-area {
  flex: 1;
}

.greeting-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.35;
}

.greeting-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
  line-height: 1.4;
}

.nav-right {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.notification-btn {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bell-icon {
  font-size: 40rpx;
  line-height: 1;
}

.notification-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 14rpx;
  height: 14rpx;
  background-color: #E85D4A;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
}

/* ========== 导航栏占位 ========== */
.nav-placeholder {
  flex-shrink: 0;
}

/* ========== 滚动容器 ========== */
.scroll-content {
  flex: 1;
}

/* ========== 搜索栏 ========== */
.search-section {
  padding: 12rpx 32rpx 18rpx;
  background-color: #FFFFFF;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  background-color: #F5F5F3;
  border-radius: 40rpx;
  padding: 0 8rpx 0 24rpx;
}

.search-icon-text {
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 12rpx;
  color: #333333;
  height: 80rpx;
}

.search-btn {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 36rpx;
  background-color: #5B8C5A;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 34rpx;
  letter-spacing: 2rpx;
}

.search-btn:active {
  background-color: #4A7A49;
}

/* ========== 分类导航 ========== */
.category-scroll {
  background-color: #FFFFFF;
  padding-bottom: 24rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 8rpx 20rpx 0;
  gap: 6rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 128rpx;
  flex-shrink: 0;
  padding: 8rpx 0;
}

.category-icon-wrapper {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F3F3F1;
  transition: all 0.25s ease;
  border: 4rpx solid transparent;
}

.category-item.active .category-icon-wrapper {
  background-color: #EAF5EB;
  border-color: #75B884;
}

.category-icon-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.category-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-star {
  font-size: 24rpx;
  line-height: 1;
}

.category-label {
  font-size: 24rpx;
  color: #666666;
  margin-top: 10rpx;
  font-weight: 500;
}

.category-item.active .category-label {
  color: #5B8C5A;
  font-weight: 700;
}

/* ========== Banner 推荐卡片（厨房背景自然融合） ========== */
.banner-card {
  margin: 20rpx 32rpx 8rpx;
  border-radius: 24rpx;
  overflow: hidden;
  height: 280rpx;
  position: relative;
}

.banner-card:active {
  opacity: 0.92;
}

/* 厨房背景图铺满 */
.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/*
 * 渐变蒙版：左侧绿色实底（保证文字可读）
 * 向右渐变为半透明，自然露出厨房场景
 */
.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: linear-gradient(
    to right,
    rgba(62, 100, 60, 0.88) 0%,
    rgba(70, 115, 68, 0.78) 30%,
    rgba(85, 135, 80, 0.45) 55%,
    rgba(100, 155, 95, 0.15) 80%,
    rgba(120, 170, 110, 0.05) 100%
  );
}

/* 内容层：左右两列 */
.banner-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  display: flex;
  align-items: stretch;
}

/* 左侧文字区 */
.banner-left {
  flex: 1;
  padding: 32rpx 0 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
}

.banner-chef-hat {
  width: 44rpx;
  height: 44rpx;
}

.banner-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.3;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.15);
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.92);
  line-height: 1.4;
  text-shadow: 0 1rpx 6rpx rgba(0,0,0,0.1);
}

.banner-btn {
  display: inline-block;
  padding: 10rpx 24rpx;
  background-color: rgba(255,255,255,0.25);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  align-self: flex-start;
  backdrop-filter: blur(4px);
}

/* 右侧寄语区 */
.banner-right {
  width: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: 24rpx;
}

.daily-quote {
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(1px);
  padding: 16rpx 24rpx 20rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
}

.quote-mark {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.9);
  font-family: Georgia, serif;
  line-height: 1;
  margin-bottom: -4rpx;
}

.quote-content {
  font-size: 24rpx;
  color: #FFFFFF;
  line-height: 1.6;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.12);
}

/* ========== 菜品双列网格 ========== */
.dish-grid {
  padding: 20rpx 32rpx 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.dish-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease;
}

.dish-card:active {
  transform: scale(0.97);
}

.dish-img-wrapper {
  position: relative;
  width: 100%;
  height: 260rpx;
  overflow: hidden;
}

.dish-image {
  width: 100%;
  height: 100%;
  background-color: #F0F0EE;
}

.dish-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.7;
}

.dish-tag.tag-signature {
  background-color: #E85D4A;
}

.dish-tag.tag-hot {
  background-color: #E89830;
}

.dish-tag.tag-new {
  background-color: #5B8C5A;
}

/* ========== 菜品信息区 ========== */
.dish-info {
  padding: 16rpx 20rpx 18rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.dish-desc {
  font-size: 22rpx;
  color: #999999;
  line-height: 1.45;
  margin-top: 6rpx;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  flex: 1;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.dish-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 22rpx;
  font-weight: 700;
  color: #E85D4A;
}

.price-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #E85D4A;
  margin-left: 2rpx;
}

.add-cart-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background-color: #5B8C5A;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(91, 140, 90, 0.3);
  transition: all 0.15s ease;
}

.add-cart-btn:active {
  transform: scale(0.88);
  background-color: #4A7A49;
}

.add-icon {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;
  margin-top: -2rpx;
}

/* ========== 空状态 ========== */
.empty-tip {
  grid-column: span 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.4;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #B5B5B5;
}

/* ========== 底部安全区占位 ========== */
.bottom-safe-area {
  height: calc(180rpx + env(safe-area-inset-bottom));
}
