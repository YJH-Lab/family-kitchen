/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f6f7f4;
}

/* 搜索框 */
.search-container {
  padding: 24rpx 26rpx 14rpx;
  background-color: #ffffff;
}

.search-box {
  display: flex;
  align-items: center;
  background: linear-gradient(180deg, #f0f0ef 0%, #ecebea 100%);
  height: 70rpx;
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 14rpx;
  color: #151515;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  background-color: #ffffff;
  padding: 0 18rpx;
  height: 100rpx;
  align-items: center;
  white-space: nowrap;
  border-bottom: 1rpx solid #ededed;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
  font-size: 39rpx;
  color: #111111;
  font-weight: 600;
}

.nav-item.active {
  color: #75b884;
}

.indicator {
  position: absolute;
  bottom: 3rpx;
  width: 48rpx;
  height: 7rpx;
  background-color: #75b884;
  border-radius: 3rpx;
}

/* 列表区 */
.dish-list {
  padding: 22rpx 26rpx 180rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
}

.dish-card {
  background-color: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 5rpx 18rpx rgba(0, 0, 0, 0.05);
}

.dish-image {
  width: 100%;
  height: 260rpx;
  background-color: #eeeeec;
}

.dish-info {
  padding: 18rpx 18rpx 16rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.dish-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111111;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.dish-desc {
  font-size: 25rpx;
  color: #8c8c8c;
  line-height: 1.4;
  margin-bottom: 14rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  flex: 1;
}

.dish-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.dish-price {
  font-size: 32rpx;
  color: #d97845;
  font-weight: 700;
}

.add-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background-color: #75b884;
  display: flex;
  justify-content: center;
  align-items: center;
}

.add-icon {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 400;
  line-height: 1;
  margin-top: -2rpx;
}

.empty-tip {
  grid-column: span 2;
  text-align: center;
  padding: 40rpx 0;
  color: #8c8c8c;
  font-size: 28rpx;
}
