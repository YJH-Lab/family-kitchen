/* pages/order/order.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f6f7f4;
  position: relative;
}

/* 购物车列表 */
.cart-list {
  flex: 1;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.cart-item {
  display: flex;
  background-color: #ffffff;
  padding: 18rpx;
  border-radius: 16rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 5rpx 18rpx rgba(0, 0, 0, 0.04);
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: #eeeeec;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.item-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #111111;
}

.item-delete {
  font-size: 26rpx;
  color: #9a9a9a;
  padding: 10rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  font-size: 34rpx;
  color: #d97845;
  font-weight: 700;
}

.item-quantity {
  font-size: 30rpx;
  color: #8c8c8c;
}

.bottom-padding {
  height: 120rpx;
}

/* 底部结算栏 */
.checkout-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background-color: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 18rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 30rpx;
  color: #111111;
}

.total-price {
  font-size: 40rpx;
  color: #d97845;
  font-weight: 700;
}

.btn-checkout {
  width: 240rpx !important;
  height: 80rpx;
  line-height: normal;
  background-color: #75b884;
  color: #ffffff;
  font-size: 34rpx;
  border-radius: 40rpx;
  margin: 0;
  padding: 0;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-bottom: 110rpx;
}

.empty-image {
  width: 210rpx;
  height: 210rpx;
  margin-bottom: 26rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8c8c8c;
  margin-bottom: 40rpx;
}

.btn-go-menu {
  width: 240rpx !important;
  height: 76rpx;
  line-height: normal;
  background-color: #75b884;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 38rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  box-sizing: border-box;
}
