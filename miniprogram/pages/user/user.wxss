/* pages/user/user.wxss */
.container {
  min-height: 100vh;
  background-color: #f6f7f4;
  padding-bottom: 48rpx;
}

/* 顶部用户信息 */
.user-header {
  display: flex;
  align-items: center;
  padding: 54rpx 32rpx 58rpx;
  background-color: #ffffff;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 34rpx;
  background-color: #dbeee0;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
}

/* 订单状态区 */
.order-status-card {
  background-color: #ffffff;
  margin: 24rpx 28rpx 18rpx;
  border-radius: 16rpx;
  padding: 26rpx 28rpx 24rpx;
  box-shadow: 0 5rpx 18rpx rgba(0, 0, 0, 0.04);
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.title-left {
  display: flex;
  align-items: center;
}

.title-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 22rpx;
}

.card-title {
  font-size: 38rpx;
  color: #111111;
  font-weight: 700;
}

.status-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 150rpx;
}

.status-icon {
  width: 68rpx;
  height: 68rpx;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 32rpx;
  color: #111111;
}

/* 菜单列表区 */
.menu-list-card {
  background-color: #ffffff;
  margin: 0 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 5rpx 18rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  height: 108rpx;
  padding: 0 28rpx;
  background-color: #ffffff;
  position: relative;
}

.menu-item::after {
  content: '';
  position: absolute;
  left: 108rpx;
  right: 24rpx;
  bottom: 0;
  height: 1rpx;
  background-color: #ececec;
}

.menu-item.group-end::after,
.menu-item:last-child::after {
  display: none;
}

.menu-item.group-start {
  margin-top: 18rpx;
  border-top: 18rpx solid #f6f7f4;
}

.menu-icon {
  width: 58rpx;
  height: 58rpx;
  margin-right: 26rpx;
  flex-shrink: 0;
}

.menu-title {
  flex: 1;
  font-size: 35rpx;
  color: #111111;
  font-weight: 500;
}

.menu-arrow {
  font-size: 64rpx;
  line-height: 1;
  color: #b7b7b7;
  font-weight: 300;
}
