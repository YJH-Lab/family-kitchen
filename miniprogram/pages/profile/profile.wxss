/* pages/profile/profile.wxss */
.container {
  background-color: #f6f7f4;
  min-height: 100vh;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.header-tips {
  font-size: 28rpx;
  color: #8c8c8c;
  margin-bottom: 30rpx;
  text-align: center;
}

.form-group {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 0 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 140rpx;
  font-size: 32rpx;
  color: #333;
}

.avatar-item {
  padding: 20rpx 0;
}

.avatar-wrapper {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
}

.avatar-wrapper::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #f6f0ec;
}

.arrow {
  color: #c7c7cc;
  font-size: 40rpx;
  margin-left: 10rpx;
  font-family: Arial;
}

.nickname-input {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #333;
}

.save-btn {
  margin-top: 80rpx;
  background-color: #75b884;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  height: 88rpx;
  line-height: 88rpx;
  width: 100% !important;
}
