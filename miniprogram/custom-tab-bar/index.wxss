.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #ffffff;
  border-top: 1rpx solid #eeeeee;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  color: #333333;
  font-size: 28rpx;
  line-height: 1.1;
  font-weight: 600;
}

.tab-text.active {
  color: #75b884;
}
